-- Все файлы встроены в этот скрипт. Работает локально и требует поддержки
-- makefolder, isfolder, writefile и getcustomasset в вашем executor.
local makeFolder = makefolder
local isFolder = isfolder
local writeFile = writefile
local getAsset = getcustomasset or getsynasset
if type(makeFolder) ~= "function" or type(isFolder) ~= "function" or type(writeFile) ~= "function" or type(getAsset) ~= "function" then
error("Executor должен поддерживать makefolder, isfolder, writefile и getcustomasset (или getsynasset).")
end

local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local lookup = {}
for i = 1, #alphabet do lookup[string.byte(alphabet, i)] = i - 1 end
local function decode64(data)
local chunks = table.create(math.ceil(#data / 4))
for i = 1, #data, 4 do
local a, b, c, d = string.byte(data, i, i + 3)
local n = lookup[a] * 262144 + lookup[b] * 4096 + (lookup[c] or 0) * 64 + (lookup[d] or 0)
local x, y, z = math.floor(n / 65536) % 256, math.floor(n / 256) % 256, n % 256
if c == 61 then
chunks[#chunks + 1] = string.char(x)
elseif d == 61 then
chunks[#chunks + 1] = string.char(x, y)
else
chunks[#chunks + 1] = string.char(x, y, z)
end
end
return table.concat(chunks)
end

local files = {
["fff.jpg"] = [==[]==],
["moment.mp3"] = [==[]==],
["farts.mp3"] = [==[]==],
["voice.mp3"] = [==[]==],
["video.mp3"] = [==[]==],
}
local folder = "TarakanyAssets"
if not isFolder(folder) then makeFolder(folder) end
local assetIds = {}
for name, data in pairs(files) do
local path = folder .. "/" .. name
writeFile(path, decode64(data))
local ok, result = pcall(getAsset, path)
if ok and result then
assetIds[name] = result
else
warn("Не удалось загрузить " .. name .. ": " .. tostring(result))
end
end
files = nil

