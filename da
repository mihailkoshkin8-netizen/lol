local soundFolder = Instance.new("Folder")
soundFolder.Name = "TarakanySounds"
soundFolder.Parent = soundService
for _, name in ipairs({"moment.mp3", "farts.mp3", "voice.mp3", "video.mp3"}) do
if assetIds[name] then
